<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SonoSonnette.App.Dialogs.VerifyPasswordWindow"
        Title="Mot de passe requis"
        Width="340" Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="Un mot de passe est requis pour modifier les paramètres."
               TextWrapping="Wrap" />
    <TextBox x:Name="PasswordBox" PasswordChar="•" Watermark="Mot de passe" />
    <TextBlock x:Name="ErrorText" Foreground="Red" IsVisible="False" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Annuler" Click="OnCancelClicked" />
      <Button Content="Valider" Click="OnValidateClicked" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
