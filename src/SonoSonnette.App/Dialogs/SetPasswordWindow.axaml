<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SonoSonnette.App.Dialogs.SetPasswordWindow"
        Title="Définir le mot de passe"
        Width="340" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="IntroText"
               Text="Ce mot de passe sera demandé pour modifier les plannings et les paramètres."
               TextWrapping="Wrap" />
    <TextBox x:Name="NewPasswordBox" PasswordChar="•" Watermark="Nouveau mot de passe" />
    <TextBox x:Name="ConfirmPasswordBox" PasswordChar="•" Watermark="Confirmer le mot de passe" />
    <TextBlock x:Name="ErrorText" Foreground="Red" IsVisible="False" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Annuler" Click="OnCancelClicked" />
      <Button Content="Enregistrer" Click="OnSaveClicked" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
